{
  "name": "2021-beer-styles",
  "version": "2.0.0",
  "description": "Beer styles in JSON format based on the 2021 BJCP style guidelines, with TypeScript types.",
  "keywords": [
    "bjcp",
    "beer",
    "brewing",
    "homebrew",
    "beer-styles",
    "style-guidelines",
    "2021",
    "json",
    "typescript"
  ],
  "author": "Jordan Riser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrdn91/bjcp-guidelines-2021.git"
  },
  "homepage": "https://github.com/jrdn91/bjcp-guidelines-2021#readme",
  "bugs": {
    "url": "https://github.com/jrdn91/bjcp-guidelines-2021/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.json": "./dist/styles.json",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run test",
    "preversion": "npm run lint && npm run test",
    "version": "npm run format && git add -A",
    "postversion": "git push && git push --tags"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
